# ─── Supabase / PostgreSQL ───────────────────────────────────────────────────
# Transaction-mode pooler (used by Prisma at runtime via pgbouncer)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Session-mode pooler (used by Prisma for migrations / db push)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ─── Supabase JS Client (optional — only needed if you add @supabase/supabase-js) ───
# NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="<your-supabase-anon-key>"

# ─── AI / LLM (required if you wire up a real AI provider) ───────────────────
# GEMINI_API_KEY="<your-google-ai-studio-key>"          # Google Gemini
# OPENAI_API_KEY="<your-openai-key>"                    # OpenAI GPT
# ANTHROPIC_API_KEY="<your-anthropic-key>"              # Anthropic Claude

# ─── Maps / Geolocation ──────────────────────────────────────────────────────
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="<your-google-maps-key>"   # if switching from Leaflet

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"
